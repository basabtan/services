  "shadows": {
    "plaster": {
      "shadow-tab": "-8px 0 0 0 #f2bd94",
      "shadow-lift": "4px 4px 0 0 #e6ddd3"
    },
    "night": {
      "shadow-tab": "-8px 0 0 0 #b04828",
      "shadow-lift": "4px 4px 0 0 #08171f"
    }
  },
  "fonts": {
    "display": "\"Effra\", \"IBM Plex Sans Arabic\", system-ui, sans-serif",
    "serif": "\"Noto Naskh Arabic\", \"Amiri\", serif",
    "text": "\"Effra\", \"IBM Plex Sans Arabic\", system-ui, sans-serif",
    "license": "Effra is a commercial Dalton Maag font. It is not distributed here; use an installed or separately licensed copy. Fallback: IBM Plex Sans Arabic.",
    "weights": "Effra Regular (400) only: build hierarchy from size, colour and the navy tab; keep font-synthesis: none."
  },
  "type": {
    "display": {
      "family": "display",
      "size": "68px",
      "lineHeight": "92px",
      "weight": 400,
      "usage": "Hero title on the Arabz page; one per page. Effra Regular at size: hierarchy comes from scale and colour, never faux bold. 44px on phones."
    },
    "h1": {
      "family": "display",
      "size": "44px",
      "lineHeight": "64px",
      "weight": 400,
      "usage": "Page title under a hero, or the hero itself on inner pages."
    },
    "h2": {
      "family": "display",
      "size": "28px",
      "lineHeight": "40px",
      "weight": 400,
      "usage": "Section titles, set inside a title tab."
    },
    "quote": {
      "family": "serif",
      "size": "28px",
      "lineHeight": "52px",
      "weight": 500,
      "usage": "Pull quotes, one per section at most."
    },
    "lead": {
      "family": "text",
      "size": "21px",
      "lineHeight": "40px",
      "weight": 400,
      "usage": "Lead paragraph directly under a hero or section title; one per section."
    },
    "h3": {
      "family": "text",
      "size": "20px",
      "lineHeight": "32px",
      "weight": 400,
      "usage": "Card titles, sub-sections."
    },
    "body-lg": {
      "family": "text",
      "size": "18px",
      "lineHeight": "32px",
      "weight": 400,
      "usage": "Lead paragraphs under a title."
    },
    "body": {
      "family": "text",
      "size": "16px",
      "lineHeight": "28px",
      "weight": 400,
      "usage": "Default running text. Arabic needs the generous 1.75 leading."
    },
    "kicker": {
      "family": "text",
      "size": "14px",
      "lineHeight": "20px",
      "weight": 400,
      "usage": "Section kicker above a title tab, in kicker colour."
    },
    "caption": {
      "family": "text",
      "size": "12px",
      "lineHeight": "20px",
      "weight": 400,
      "usage": "Meta, dates, figure captions, in ink-muted."
    },
    "label": {
      "family": "text",
      "size": "12px",
      "lineHeight": "16px",
      "weight": 400,
      "usage": "Field labels, chart axes, badges, in ink. No letter-spacing (it breaks Arabic joins)."
    }
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "space-7": "48px",
    "space-8": "64px"
  },
  "radius": {
    "radius-none": "0",
    "radius-sharp": "2px"
  },
  "border": {
    "border-hair": "1px",
    "border-control": "1.5px",
    "border-frame": "6px",
    "band-height": "14px"
  },
  "opacity": {
    "plaster": {
      "opacity-grain": "0.06",
      "opacity-lattice": "0.32",
      "opacity-photo-tint": "0.22"
    },
    "night": {
      "opacity-grain": "0.08",
      "opacity-lattice": "0.32",
      "opacity-photo-tint": "0.22"
    }
  },
  "motifs": [
    "title tab",
    "twin band",
    "spine stripe",
    "rawshan lattice",
    "plaster grain",
    "dotted frame",
    "rust frame",
    "date line"
  ]
}
