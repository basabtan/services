{
  "theme": "rawshan",
  "modes": {
    "plaster": "rawshan",
    "night": "rawshan-night"
  },
  "name": "Rawshan",
  "description": "Hijazi-heritage, Arabic-first theme for the Arabz page: multicolour identity bars, one navy block per section, whitewashed plaster, teak rawshan lattice. Square corners, hard offset shadows, Effra Regular.",
  "attribute": "data-theme=\"rawshan\" (Plaster) or data-theme=\"rawshan-night\" (Night); set dir=\"rtl\" lang=\"ar\"",
  "prefix": "--rw-",
  "colorRules": "70/20/10: about 70% plaster surfaces, 20% navy (tab, action, slab), 10% accent. All seven identity hues appear together only in the spine stripe, once per page.",
